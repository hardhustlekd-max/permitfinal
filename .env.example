# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Supabase Database & Auth Configuration
# SUPABASE_URL: The base URL for your Supabase project (e.g. https://xyz.supabase.co)
SUPABASE_URL=
# SUPABASE_ANON_KEY: The public anon key for Supabase client & server requests
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: Optional secret service role key for administrative server operations
SUPABASE_SERVICE_ROLE_KEY=

# GitHub Personal Access Token for Git Operations
GITHUB_TOKEN=
